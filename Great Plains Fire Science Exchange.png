<script id="gpfse-a11y-fixes">
(function () {
  function hasPositiveTabindex(el) {
    var raw = el.getAttribute('tabindex');
    if (raw === null) return false;
    var value = parseInt(raw, 10);
    return !isNaN(value) && value > 0;
  }

  function labelChosenSearch(selector, label) {
    document.querySelectorAll(selector).forEach(function (input) {
      input.setAttribute('aria-label', label);
      input.setAttribute('title', label);
    });
  }

  // Usercentrics injects an <h3> in its video-embed placeholder that skips the
  // page's real heading order; it's filler chrome, not content, so demote it.
  function demoteUcEmbeddingHeadings() {
    document.querySelectorAll('.uc-embedding-wrapper > h3').forEach(function (h3) {
      if (h3.dataset.gpfseDemoted) return;
      var replacement = document.createElement('div');
      replacement.className = h3.className;
      replacement.innerHTML = h3.innerHTML;
      replacement.dataset.gpfseDemoted = '1';
      h3.replaceWith(replacement);
    });
  }

  function applyGpfseA11yFixes() {
    document.querySelectorAll('#gform_1 [tabindex]').forEach(function (el) {
      if (hasPositiveTabindex(el)) el.removeAttribute('tabindex');
    });

    labelChosenSearch('#input_1_19_chosen input.chosen-search-input', 'Search PBA registration options');
    labelChosenSearch('#input_4_8_chosen input.chosen-search-input', 'Search listserv options');

    demoteUcEmbeddingHeadings();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applyGpfseA11yFixes);
  } else {
    applyGpfseA11yFixes();
  }

  if (window.jQuery) {
    window.jQuery(document).on('gform_post_render gform_page_loaded gform_post_conditional_logic', applyGpfseA11yFixes);
  }

  [100, 500, 1000, 2000].forEach(function (delay) {
    window.setTimeout(applyGpfseA11yFixes, delay);
  });

  // Usercentrics loads its embed placeholders asynchronously per video block.
  var ucObserver = new MutationObserver(demoteUcEmbeddingHeadings);
  ucObserver.observe(document.body, { childList: true, subtree: true });
})();
</script>
    <script id="gpfse-publication-accessibility" data-no-optimize="1">(function () {
  'use strict';

  function ready(callback) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', callback, { once: true });
    } else {
      callback();
    }
  }

  function publicationRoot() {
    var hero = document.querySelector('.fl-builder-content[data-post-id] .gpe-publication-hero');
    return hero ? hero.closest('.fl-builder-content[data-post-id]') : null;
  }

  function normalizedText(value) {
    return String(value || '').replace(/\s+/g, ' ').trim();
  }

  function makeTitleWhitespaceExplicit(root) {
    var title = root.querySelector('h1');
    var lineBreak = title ? title.querySelector('br') : null;
    if (lineBreak && lineBreak.nextSibling && !/^[\s\u00a0]/.test(lineBreak.nextSibling.textContent || '')) {
      lineBreak.parentNode.insertBefore(document.createTextNode('\u00a0'), lineBreak.nextSibling);
    }
  }

  function hasReplacementName(node, label) {
    if (label === 'photo' || label === 'image') {
      var image = node.tagName === 'IMG' ? node : node.querySelector('img[alt]');
      return !!image && normalizedText(image.getAttribute('alt')) !== '';
    }
    return (label === 'heading' || label === 'text editor') && normalizedText(node.textContent) !== '';
  }

  function normalizeBuilderSemantics(root) {
    var removableLabels = /^(photo|image|heading|text editor|button|social icons|search form|advanced menu|menu)$/i;
    root.querySelectorAll('.fl-module[role="presentation"][aria-label]').forEach(function (module) {
      var label = normalizedText(module.getAttribute('aria-label'));
      if (!removableLabels.test(label)) return;
      var replacement = hasReplacementName(module, label.toLowerCase())
        || !!module.querySelector('a[href], button, input, select, textarea, nav, form, img[alt]');
      if (replacement) {
        module.removeAttribute('aria-label');
        module.removeAttribute('role');
      }
    });

    root.querySelectorAll('*').forEach(function (node) {
      var label = normalizedText(node.getAttribute('aria-label')).toLowerCase();
      if (hasReplacementName(node, label)) node.removeAttribute('aria-label');
      if (/^(H[1-6]|FIGURE|FIGCAPTION|TABLE|CAPTION|THEAD|TBODY|TR|TH|TD|UL|OL|LI|A)$/.test(node.tagName)
          && node.getAttribute('role') === 'presentation') {
        node.removeAttribute('role');
      }
    });
  }

  function normalizePageBreakMarkers(root) {
    root.querySelectorAll('.gpe-publication-page-break').forEach(function (marker) {
      // This is a print-composition control, not document content. Keep the
      // Separator out of both the browser and generated-PDF accessibility trees.
      marker.setAttribute('aria-hidden', 'true');
      marker.removeAttribute('aria-label');
      marker.removeAttribute('role');
    });
  }

  function normalizeSubmenuControls(postRoot) {
    var postId = postRoot.getAttribute('data-post-id') || 'publication';
    document.querySelectorAll('button.pp-menu-toggle[aria-controls]').forEach(function (button, index) {
      var item = button.closest('li');
      var submenu = item ? item.querySelector(':scope > ul.sub-menu') : null;
      if (!submenu) return;
      var controlId = 'gpe-publication-' + postId + '-submenu-' + String(index + 1);
      submenu.id = controlId;
      button.setAttribute('aria-controls', controlId);
      button.removeAttribute('aria-haspopup');
    });
  }

  function normalizeFigures(root) {
    root.querySelectorAll('.fl-module-pp-image, .fl-module-photo').forEach(function (module) {
      var existingFigure = module.querySelector('figure.gpe-publication-figure');
      if (existingFigure) {
        var existingCaption = existingFigure.querySelector('figcaption');
        if (existingCaption) existingCaption.classList.add('gpe-publication-caption');
        return;
      }
      var container = module.querySelector('.pp-photo-container, .fl-photo');
      var image = module.querySelector('img');
      if (!container || !image) return;

      var alternative = normalizedText(image.getAttribute('alt'));
      if (!alternative) return;
      var sourceCaption = module.querySelector('.pp-photo-caption, .fl-photo-caption');
      var figure = document.createElement('figure');
      figure.className = 'gpe-publication-figure';
      figure.setAttribute('aria-label', alternative);
      container.parentNode.insertBefore(figure, container);
      figure.appendChild(container);

      if (sourceCaption && normalizedText(sourceCaption.textContent) !== '') {
        var caption = document.createElement('figcaption');
        caption.className = sourceCaption.className;
        caption.classList.add('gpe-publication-caption');
        while (sourceCaption.firstChild) caption.appendChild(sourceCaption.firstChild);
        sourceCaption.remove();
        figure.appendChild(caption);
      } else if (sourceCaption) {
        sourceCaption.remove();
      }

      image.setAttribute('alt', '');
      image.setAttribute('role', 'presentation');
      image.setAttribute('aria-hidden', 'true');
      image.removeAttribute('title');
    });
  }

  function normalizeTables(root) {
    var readyCount = 0;
    root.querySelectorAll('.gpe-publication-table-unit table').forEach(function (table) {
      var unit = table.closest('.gpe-publication-table-unit');
      var label = unit ? unit.querySelector('.gpe-publication-figure-label') : null;
      var caption = table.querySelector(':scope > caption');
      if (!caption && label && normalizedText(label.textContent) !== '') {
        caption = document.createElement('caption');
        caption.className = 'gpe-publication-figure-label';
        while (label.firstChild) caption.appendChild(label.firstChild);
        label.remove();
        table.insertBefore(caption, table.firstChild);
      }
      if (caption) caption.classList.add('gpe-publication-caption');
      table.querySelectorAll('thead th').forEach(function (cell) {
        cell.setAttribute('scope', 'col');
      });
      table.querySelectorAll('tbody th').forEach(function (cell) {
        cell.setAttribute('scope', 'row');
      });
      if (caption) readyCount += 1;
    });
    return readyCount;
  }

  function normalizeTableOfContents(root) {
    root.querySelectorAll('.gpe-publication-toc-row .pp-toc-container').forEach(function (toc, index) {
      if (toc.tagName !== 'NAV') toc.setAttribute('role', 'navigation');
      if (!toc.hasAttribute('aria-label')) toc.setAttribute('aria-label', 'Article contents');
      var module = toc.closest('.fl-module-pp-toc');
      if (module) {
        module.removeAttribute('aria-label');
        module.removeAttribute('role');
      }
      var header = toc.querySelector('.pp-toc-header');
      var body = toc.querySelector('.pp-toc-body');
      if (!header || !body) return;
      var postId = root.getAttribute('data-post-id') || 'publication';
      body.id = body.id || 'gpe-publication-' + postId + '-toc-' + String(index + 1);
      header.setAttribute('role', 'button');
      header.setAttribute('tabindex', '0');
      header.setAttribute('aria-controls', body.id);
      var reflectState = function () {
        header.setAttribute('aria-expanded', header.classList.contains('pp-toc-collapsed') ? 'false' : 'true');
      };
      reflectState();
      if (!header.hasAttribute('data-gpe-keyboard-control')) {
        header.setAttribute('data-gpe-keyboard-control', 'true');
        header.addEventListener('keydown', function (event) {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          header.click();
        });
        new MutationObserver(reflectState).observe(header, { attributes: true, attributeFilter: ['class'] });
      }
    });
  }

  function normalize(root) {
    if (!root) return null;
    document.documentElement.lang = document.documentElement.lang || 'en-US';
    makeTitleWhitespaceExplicit(root);
    normalizeFigures(root);
    normalizeTables(root);
    normalizeTableOfContents(root);
    normalizePageBreakMarkers(root);
    normalizeBuilderSemantics(root);
    normalizeBuilderSemantics(document);
    normalizeSubmenuControls(root);
    root.setAttribute('data-gpe-publication-accessibility-ready', 'true');
    return root;
  }

  window.gpfsePublicationAccessibility = { normalize: normalize };
  ready(function () { normalize(publicationRoot()); });
}());
</script><script>
