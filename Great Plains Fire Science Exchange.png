<style id="gpfse-publication-styles" data-no-optimize="1">/*
 * GPFSE publication styling — global, class-driven, publication-generic.
 *
 * Every GPFSE publication page uses these gpe-publication-* classes instead
 * of page-local Beaver Builder layout CSS, so the look of all publications
 * changes here, in one place.  Type and color choices follow the WCAG 2.2 AA
 * review of the prescribed-burning publication.
 */

:root {
  /* The title orange is sampled from the supplied print reference and is
   * within 4.6 RGB units of #e07744 in the logo gradient. The darker red is
   * an exact opaque logo pixel and keeps small white text at 4.78:1. */
  --gpe-publication-brand-orange: #dc7842;
  --gpe-publication-brand-red: #c9462a;
  --gpe-publication-print-table-clearance: 0.08in;
  --gpe-publication-print-table-space-after: 12pt;
  --gpe-publication-print-byline-space-before: 0.125in;
  --gpe-publication-print-byline-space-after: 0.166667in;
  --gpe-publication-print-section-space-before: 0.105in;
  --gpe-publication-print-section-space-after: 0.08in;
  --gpe-publication-print-subheading-space-before: 0.125in;
  --gpe-publication-print-subheading-space-after: 0.04in;
  --gpe-publication-print-figure-space-before: 0.03in;
  --gpe-publication-print-figure-space-after: 0.25in;
  --gpe-publication-caption-color: #3f6f27;
  --gpe-publication-caption-font-family: "Liberation Serif", "Nimbus Roman", "Times New Roman", serif;
  --gpe-publication-caption-font-size: 11pt;
  --gpe-publication-caption-font-weight: 700;
  --gpe-publication-caption-line-height: 1.14;
}

.gpe-publication-hero {
  background: #fff;
  border-bottom: 2px solid var(--gpe-publication-brand-red);
}

.gpe-publication-hero h1,
h1.gpe-publication-heading,
h1.gpe-publication-heading span {
  color: #202124 !important;
  font-family: Arial, Helvetica, sans-serif !important;
  font-size: clamp(32px, 5vw, 48px) !important;
  font-weight: 700 !important;
  letter-spacing: normal !important;
  line-height: 1.12 !important;
  margin-top: 18px;
}

/* A non-breaking space is retained after an authored line break so Chromium
 * gives the PDF outline a separated title. Pull the following span back by
 * one space so the painted title remains flush left like the source design. */
.gpe-publication-hero h1 br + span,
h1.gpe-publication-heading br + span {
  position: relative;
  left: -0.278em;
}

.gpe-publication-banner img {
  width: 100%;
  height: auto;
}

/* The module class is the complete editor-facing contract: adding it to a
 * Beaver Builder HTML module right-aligns the current-publication download
 * button on screen and the print rules below exclude the complete module. */
.gpe-publication-download {
  text-align: right;
}

/* Print-only controls stay off the public web page, but remain visible in
 * Beaver Builder so editors can select and change them. */
@media screen {
  html:not(.fl-builder-edit) body:not(.fl-builder-edit) :is(.gpe-publication-banner,
      .gpe-publication-print-info-row,
      .gpe-publication-print-only) {
    display: none !important;
  }

  :is(html, body).fl-builder-edit :is(.gpe-publication-banner,
      .gpe-publication-print-info-row,
      .gpe-publication-print-only) {
    display: block !important;
    outline: 2px dashed var(--gpe-publication-brand-orange);
    outline-offset: -2px;
  }
}

.gpe-publication-kicker {
  color: var(--gpe-publication-brand-red) !important;
  font-size: 16px !important;
  font-weight: 600 !important;
  letter-spacing: normal !important;
  line-height: 1.5 !important;
  text-transform: none !important;
}

.gpe-publication-byline {
  font-size: 1.08rem;
}

:is(.gpe-publication-byline.fl-rich-text, .gpe-publication-byline .fl-rich-text) > p:not(.gpe-publication-kicker) {
  display: flex;
  width: 100%;
  align-items: baseline;
  justify-content: space-between;
  gap: 1.5rem;
}

:is(.gpe-publication-byline.fl-rich-text, .gpe-publication-byline .fl-rich-text) > p:not(.gpe-publication-kicker) > span {
  margin-left: auto;
  text-align: right;
}

.gpe-publication-section,
.gpe-publication-hero {
  color: #202124;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 16px;
  line-height: 1.65;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

.gpe-publication-section *,
.gpe-publication-hero * {
  font-family: inherit;
}

h2.gpe-publication-heading,
h3.gpe-publication-heading,
.gpe-publication-heading h2,
.gpe-publication-heading h3,
.gpe-publication-copy h3 {
  color: #26372b !important;
  font-family: inherit !important;
  font-weight: 700 !important;
  letter-spacing: normal !important;
  text-transform: none !important;
}

h2.gpe-publication-heading,
.gpe-publication-heading h2 {
  font-size: 26px !important;
  line-height: 1.25 !important;
}

h3.gpe-publication-heading,
.gpe-publication-heading h3,
.gpe-publication-copy h3 {
  color: #7a3814;
  font-size: 21px !important;
  line-height: 1.3 !important;
  margin-top: 1.4em;
}

.gpe-publication-copy {
  color: #202124;
  font-family: inherit !important;
  font-size: 16px !important;
  line-height: 1.65 !important;
}

.gpe-publication-copy li {
  margin-bottom: .48em;
}

.gpe-publication-toc-row {
  background: #fff;
  color: #202124;
}

.gpe-publication-toc-row .pp-toc-container {
  background: #f4f3ef;
  border: 1px solid #d7d4cc;
  color: #202124;
  padding: 18px 20px;
}

.gpe-publication-toc-row .pp-toc-header,
.gpe-publication-toc-row .pp-toc-header-title {
  background: #f4f3ef !important;
  color: #26372b;
  font-weight: 700;
}

.gpe-publication-toc-row .pp-toc-header[role="button"]:focus-visible {
  box-shadow: 0 0 0 3px #fff, 0 0 0 6px #174f7a;
  outline: 2px solid transparent;
  outline-offset: 3px;
}

.gpe-publication-toc-row .pp-toc-list-wrapper {
  columns: 2;
  column-gap: 36px;
  margin-top: 12px;
}

.gpe-publication-toc-row .pp-toc-list-wrapper :is(ol, ul) {
  margin-top: 0;
}

.gpe-publication-toc-row .pp-toc-container a {
  color: #174f7a;
  display: inline-block;
  min-height: 28px;
  padding: 4px 6px;
  text-decoration: underline;
}

.gpe-publication-photo img {
  border-radius: 0;
  box-shadow: none;
}

.gpe-publication-section .pp-photo,
.gpe-publication-section .fl-photo {
  max-width: 680px;
  margin-left: 0;
  margin-right: 0;
  text-align: left;
}

.gpe-publication-section .pp-photo-align-center,
.gpe-publication-section .pp-photo-align-responsive-center {
  text-align: left;
}

/* A figure shrink-wraps its image, and the caption (table-caption) can be
   no wider than the image. */
.gpe-publication-section figure.gpe-publication-figure {
  display: table;
  table-layout: auto;
  width: auto;
  max-width: 100%;
  margin: 0 0 1.2em;
}

.gpe-publication-section figure.gpe-publication-figure figcaption {
  display: table-caption;
  caption-side: bottom;
  background: transparent;
  width: auto !important;
  max-width: 100% !important;
}

.gpe-publication-section figure.gpe-publication-figure :is(.pp-photo-container,
    .pp-photo,
    .pp-photo-content,
    .pp-photo-content-inner,
    .fl-photo) {
  width: auto !important;
  max-width: 100% !important;
}

.gpe-publication-section figure.gpe-publication-figure img {
  width: auto !important;
  max-width: 100% !important;
}

.gpe-publication-section .pp-photo-container,
.gpe-publication-section .pp-photo,
.gpe-publication-section .pp-photo-content,
.gpe-publication-section .pp-photo-content-inner {
  display: block;
  max-width: 680px;
}

.gpe-publication-section .pp-photo img {
  display: block;
  max-width: 100%;
  height: auto;
}

.gpe-publication-hero .pp-photo,
.gpe-publication-hero .fl-photo {
  max-width: none;
}

.gpe-publication-info-bar {
  background: var(--gpe-publication-brand-red);
  color: #fff;
  margin-top: 1.4em;
  padding: 10px 14px;
  text-align: center;
}

.gpe-publication-info-bar a {
  color: #fff !important;
  font-weight: 700;
  text-decoration: underline;
}

.gpe-publication-photo .pp-photo-caption,
.gpe-publication-photo .fl-photo-caption-below,
.gpe-publication-figure-label,
.gpe-publication-section table caption {
  color: #303134;
  font-family: inherit;
  font-size: 15px !important;
  font-weight: 400;
  line-height: 1.45;
  padding-top: 9px;
  text-align: left;
}

.gpe-publication-section table caption {
  caption-side: bottom;
  padding-top: 0.6em;
}

.gpe-publication-section a:not(.fl-button):not(.pp-button),
.gpe-publication-hero a:not(.fl-button):not(.pp-button) {
  color: #174f7a;
  text-decoration: underline;
  text-decoration-thickness: 0.09em;
  text-underline-offset: 0.14em;
}

.gpe-publication-table-wrap {
  font-size: 15px;
  overflow-x: auto;
  overscroll-behavior-inline: contain;
}

.gpe-publication-table-wrap table {
  border: 1px solid #59625b;
  border-collapse: collapse;
  table-layout: fixed;
  width: 100%;
}

.gpe-publication-table-wrap th,
.gpe-publication-table-wrap td {
  border: 1px solid #929992;
  padding: 12px 14px;
  text-align: left;
  vertical-align: top;
  overflow-wrap: break-word;
}

.gpe-publication-table-wrap thead th {
  background: #eef1e9;
  color: #26372b;
}

.gpe-publication-table-wrap tbody th {
  background: #f7f6f2;
  color: #26372b;
  width: 22%;
}

.gpe-publication-table-wrap :is(th, td):nth-child(2) {
  width: 32%;
}

.gpe-publication-table-wrap :is(th, td):nth-child(3) {
  width: 46%;
}

.gpe-publication-summary {
  background: #eef2e9;
  border-top: 4px solid #809457;
  border-bottom: 4px solid #809457;
}

.gpe-publication-reference-list {
  padding-left: 1.25rem;
}

.gpe-publication-reference-list li {
  margin-bottom: 1rem;
}

.gpe-publication-download .fl-button,
.gpe-publication-download .pp-button {
  font-size: 16px !important;
  min-height: 44px;
}

.gpe-publication-section a:focus-visible,
.gpe-publication-hero a:focus-visible,
.gpe-publication-section button:focus-visible,
.gpe-publication-section [tabindex]:focus-visible {
  border-radius: 2px;
  box-shadow: 0 0 0 3px #fff, 0 0 0 6px #174f7a;
  outline: 2px solid transparent;
  outline-offset: 3px;
}

.gpe-publication-section [id],
.gpe-publication-hero [id] {
  scroll-margin-top: 6rem;
}

@media (max-width: 768px) {
  .gpe-publication-section,
  .gpe-publication-hero {
    font-size: 17px;
  }

  .gpe-publication-toc-row .pp-toc-list-wrapper {
    columns: 1;
  }

  .gpe-publication-section .fl-col {
    width: 100% !important;
  }

  :is(.gpe-publication-byline.fl-rich-text, .gpe-publication-byline .fl-rich-text) > p:not(.gpe-publication-kicker) {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.15rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .gpe-publication-section,
  .gpe-publication-section *,
  .gpe-publication-hero,
  .gpe-publication-hero * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}

/* ==========================================================
   Publication print layout.

   The builder content itself is the two-column flow. Rows carrying a
   semantic utility class span that flow for front matter, tables, wide
   figures, and the closing information bar. This keeps duplicated
   publications editable in Beaver Builder and avoids node-ID or text-based
   DOM surgery at print time.
   ========================================================== */

@page {
  size: letter;
  margin: 0.5in;

  @bottom-center {
    content: counter(page);
    color: #202124;
    font-family: "Liberation Sans", Arial, Helvetica, sans-serif;
    font-size: 8pt;
  }
}

@media print {
  body:has(.gpe-publication-hero) {
    margin: 0 !important;
    padding: 0 !important;
    background: #fff !important;
    color: #202124 !important;
    font-family: "Liberation Serif", "Nimbus Roman", "Times New Roman", serif !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }

  body:has(.gpe-publication-hero) :is(#wpadminbar,
      .no-print,
      header.fl-builder-content,
      footer.fl-builder-content,
      .fl-builder-content[data-type="header"],
      .fl-builder-content[data-type="footer"],
      .fl-page-header,
      .fl-page-nav-wrap,
      .fl-page-footer-wrap,
      .mega-menu-wrap,
      .mega-menu-toggle,
      .pp-search-form,
      .searchwp-live-search-results,
      iframe,
      noscript,
      dialog,
      [id*="usercentrics" i],
      [class*="usercentrics" i],
      [id^="uc-"],
      [class^="uc-"],
      [class*=" uc-"]),
  body:has(.gpe-publication-hero) .gpe-publication-toc-row,
  body:has(.gpe-publication-hero) .gpe-publication-download {
    display: none !important;
  }

  body:has(.gpe-publication-hero) :is(.fl-page, #fl-main-content, .fl-page-content) {
    float: none !important;
    width: auto !important;
    max-width: none !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content[data-post-id] {
    box-sizing: border-box !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    column-count: 2 !important;
    column-gap: 0.28in !important;
    column-fill: auto !important;
    font-size: 10.5pt !important;
    line-height: 1.16 !important;
  }

  /* Ordinary builder rows dissolve into the publication-wide column flow. */
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content > .fl-row.gpe-publication-section:not(.gpe-publication-table-row):not(.gpe-publication-figure-row):not(.gpe-publication-print-info-row),
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content > .fl-row.gpe-publication-section:not(.gpe-publication-table-row):not(.gpe-publication-figure-row):not(.gpe-publication-print-info-row) :is(.fl-row-content-wrap,
      .fl-row-content,
      .fl-row-fixed-width,
      .fl-row-full-width,
      .fl-col-group,
      .fl-col,
      .fl-col-content) {
    display: contents !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content > .fl-row.gpe-publication-hero,
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content > .fl-row.gpe-publication-table-row,
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content > .fl-row.gpe-publication-figure-row {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    column-span: all !important;
  }

  /* Footer spacing is authored on its direct Builder wrapper below. */
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content > .fl-row.gpe-publication-print-info-row {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    column-span: all !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content > :is(.gpe-publication-hero,
      .gpe-publication-figure-row) :is(.fl-row-content-wrap,
      .fl-row-content,
      .fl-row-fixed-width,
      .fl-row-full-width,
      .fl-col-group,
      .fl-col,
      .fl-col-content) {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Shared print rhythm separates a table from the surrounding columns.
     Builder row spacing remains at its defaults; this one reusable rule owns
     the PDF-only clearance for every publication table. */
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content > .gpe-publication-table-row > .fl-row-content-wrap {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding-top: var(--gpe-publication-print-table-clearance) !important;
    padding-right: 0 !important;
    padding-bottom: var(--gpe-publication-print-table-space-after) !important;
    padding-left: 0 !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content > .gpe-publication-table-row > .fl-row-content-wrap :is(.fl-row-content,
      .fl-row-fixed-width,
      .fl-row-full-width,
      .fl-col-group,
      .fl-col,
      .fl-col-content) {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* The footer is the sole intentional Builder spacing control: its top
     padding creates the final-page breathing room. Normalize every side that
     is not part of that explicit editorial control. */
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content > .gpe-publication-print-info-row > .fl-row-content-wrap {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin-right: 0 !important;
    margin-left: 0 !important;
    padding-right: 0 !important;
    padding-bottom: 0 !important;
    padding-left: 0 !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content > .gpe-publication-print-info-row > .fl-row-content-wrap :is(.fl-row-content,
      .fl-row-fixed-width,
      .fl-row-full-width,
      .fl-col-group,
      .fl-col,
      .fl-col-content) {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content .fl-module,
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content .fl-module-content {
    display: block !important;
    box-sizing: border-box !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important;
  }

  /* This must follow the generic module reset above. That reset deliberately
     uses !important and otherwise wins over the earlier utility hide rule,
     causing module-level no-print/download controls to leak into the PDF. */
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content .fl-module.no-print,
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content .fl-module.gpe-publication-download,
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content .no-print,
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content .gpe-publication-download {
    display: none !important;
  }

  /* A native Beaver Builder Separator carrying this class is an editorial
     page-break marker. Its visible line is an editor affordance only; the
     zero-height module contributes no content or spacing to the PDF. */
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content .fl-module.gpe-publication-page-break {
    display: block !important;
    width: 100% !important;
    height: 0 !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    background: transparent !important;
    border: 0 !important;
    break-after: page !important;
    page-break-after: always !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content .gpe-publication-page-break * {
    display: none !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .gpe-publication-toc-row,
  body:has(.gpe-publication-hero) #fl-main-content .gpe-publication-toc-row * {
    display: none !important;
  }

  /* Front matter follows the supplied publication without hard-coding a
     page. The issue label remains attached to the banner when text grows. */
  body:has(.gpe-publication-hero) #fl-main-content .gpe-publication-hero {
    position: relative !important;
    margin-bottom: 0.08in !important;
    background: #fff !important;
    border: 0 !important;
    break-inside: avoid-page !important;
  }

  .gpe-publication-hero .pp-photo img,
  .gpe-publication-hero .fl-photo img {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    max-height: none !important;
    margin: 0 0 0.07in !important;
    object-fit: contain !important;
  }

  body:has(.gpe-publication-hero) h1,
  body:has(.gpe-publication-hero) h1 span {
    margin: 0 0 0.055in !important;
    padding-left: 0 !important;
    color: var(--gpe-publication-brand-orange) !important;
    font-family: "Liberation Sans", "Nimbus Sans", Arial, Helvetica, sans-serif !important;
    font-size: 21.5pt !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    line-height: 1.12 !important;
    text-indent: 0 !important;
  }

  body:has(.gpe-publication-hero) h1 br + span {
    left: -0.278em !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .gpe-publication-kicker {
    position: static !important;
    display: block !important;
    box-sizing: border-box !important;
    width: 100% !important;
    height: 0 !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .gpe-publication-kicker p {
    position: absolute !important;
    top: 0 !important;
    right: 0.12in !important;
    left: auto !important;
    z-index: 1 !important;
    display: inline-block !important;
    width: auto !important;
    min-width: 0 !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0.045in 0.1in !important;
    background: var(--gpe-publication-brand-red) !important;
    color: #fff !important;
    font-family: "Liberation Sans", "Nimbus Sans", Arial, Helvetica, sans-serif !important;
    font-size: 8pt !important;
    font-weight: 400 !important;
    line-height: 1.15 !important;
    white-space: nowrap !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .gpe-publication-kicker,
  body:has(.gpe-publication-hero) #fl-main-content .gpe-publication-kicker * {
    color: #fff !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content .fl-module.gpe-publication-byline {
    margin: var(--gpe-publication-print-byline-space-before) 0
      var(--gpe-publication-print-byline-space-after) !important;
  }

  .gpe-publication-byline,
  .gpe-publication-byline .fl-module-content,
  .gpe-publication-byline .fl-rich-text,
  .gpe-publication-byline p:not(.gpe-publication-kicker) {
    width: 100% !important;
    max-width: none !important;
    color: #202124 !important;
    font-family: "Liberation Sans", "Nimbus Sans", Arial, Helvetica, sans-serif !important;
    font-size: 8.5pt !important;
    line-height: 1.2 !important;
  }

  .gpe-publication-byline .fl-module-content,
  .gpe-publication-byline .fl-rich-text,
  .gpe-publication-byline p:not(.gpe-publication-kicker) {
    margin: 0 !important;
  }

  :is(.gpe-publication-byline.fl-rich-text, .gpe-publication-byline .fl-rich-text) > p:not(.gpe-publication-kicker) {
    position: relative !important;
    display: flex !important;
    box-sizing: border-box !important;
    align-items: baseline !important;
    justify-content: space-between !important;
    gap: 0.2in !important;
    padding: 0 !important;
  }

  :is(.gpe-publication-byline.fl-rich-text, .gpe-publication-byline .fl-rich-text) > p:not(.gpe-publication-kicker) > span {
    position: absolute !important;
    top: 0 !important;
    right: 0 !important;
    margin-left: 0.2in !important;
    text-align: right !important;
  }

  /* Body type uses the closest metrically compatible fonts installed in
     the renderer; headings remain sans-serif like the reference. */
  .gpe-publication-copy,
  .gpe-publication-copy p,
  .gpe-publication-copy li {
    max-width: none !important;
    color: #202124 !important;
    font-family: inherit !important;
    font-size: 12pt !important;
    line-height: 1.14 !important;
    orphans: 3 !important;
    widows: 3 !important;
  }

  .gpe-publication-copy p {
    margin: 0 0 0.085in !important;
  }

  .gpe-publication-copy ul,
  .gpe-publication-copy ol {
    margin: 0.025in 0 0.075in 0.17in !important;
    padding: 0 !important;
  }

  .gpe-publication-copy li {
    margin: 0 0 0.028in !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .fl-module-heading {
    /* `avoid-column` does not cover a page boundary inside Chromium's
       multicolumn pagination. `avoid` keeps the heading with the first body
       lines at both column and page boundaries. */
    break-after: avoid !important;
    page-break-after: avoid !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .fl-module-heading + .fl-module-rich-text {
    break-before: avoid !important;
    page-break-before: avoid !important;
  }

  /* Optional authored continuation point used when a figure should finish
     the current column and its following discussion should start the next. */
  .gpe-publication-followup {
    break-before: column !important;
  }

  .gpe-publication-column-start {
    break-before: column !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content :is(h2.fl-module.gpe-publication-heading, h2.gpe-publication-heading, .gpe-publication-heading h2) {
    margin: var(--gpe-publication-print-section-space-before) 0 0 !important;
    padding: 0 0 var(--gpe-publication-print-section-space-after) !important;
    color: #3f6f27 !important;
    font-family: "Liberation Sans", "Nimbus Sans", Arial, Helvetica, sans-serif !important;
    font-size: 12pt !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    line-height: 1.14 !important;
    text-transform: none !important;
    break-after: avoid !important;
    page-break-after: avoid !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content :is(h3.fl-module.gpe-publication-heading, h3.gpe-publication-heading, .gpe-publication-heading h3, .gpe-publication-copy h3) {
    margin: var(--gpe-publication-print-subheading-space-before) 0 0 !important;
    padding: 0 0 var(--gpe-publication-print-subheading-space-after) !important;
    color: #3f6f27 !important;
    font-family: "Liberation Serif", "Nimbus Roman", "Times New Roman", serif !important;
    font-size: 11pt !important;
    font-weight: 700 !important;
    line-height: 1.15 !important;
    break-after: avoid !important;
    page-break-after: avoid !important;
  }

  /* The semantic normalizer promotes the Builder heading module itself to
     H1/H2/H3. Give the cover title a measured gap before the byline without
     relying on Beaver Builder's generic module margin reset. */
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content h1.fl-module.gpe-publication-heading {
    margin-bottom: 0.033in !important;
  }

  /* Figures follow the Western Forbs intrinsic-width pattern: image and
     caption remain atomic, and table-caption bounds the caption to the
     rendered image rather than its Beaver Builder column. */
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content .gpe-publication-section:not(.gpe-publication-figure-row) :is(.fl-module-pp-image, .fl-module-photo) {
    margin: var(--gpe-publication-print-figure-space-before) 0 var(--gpe-publication-print-figure-space-after) !important;
    break-inside: avoid-column !important;
    page-break-inside: avoid !important;
  }

  .gpe-publication-section figure.gpe-publication-figure {
    display: table !important;
    table-layout: auto !important;
    width: auto !important;
    max-width: 100% !important;
    margin: 0 auto !important;
    break-inside: avoid-column !important;
    page-break-inside: avoid !important;
  }

  .gpe-publication-section figure.gpe-publication-figure figcaption {
    display: table-caption !important;
    width: auto !important;
    max-width: 100% !important;
    caption-side: bottom !important;
  }

  .gpe-publication-section figure.gpe-publication-figure :is(.pp-photo-container,
      .pp-photo,
      .pp-photo-content,
      .pp-photo-content-inner,
      .fl-photo) {
    display: block !important;
    width: auto !important;
    max-width: 100% !important;
    margin: 0 !important;
  }

  .gpe-publication-section figure.gpe-publication-figure :is(.pp-photo, .fl-photo) img {
    display: block !important;
    width: auto !important;
    max-width: 100% !important;
    height: auto !important;
    max-height: none !important;
    margin: 0 auto !important;
    object-fit: contain !important;
  }

  /* Photo and table captions share one semantic class and one complete type
     treatment. Styling descendants prevents authored strong/span markup from
     making only part of a table caption inherit the table's body color. */
  body:has(.gpe-publication-hero) #fl-main-content .gpe-publication-caption,
  body:has(.gpe-publication-hero) #fl-main-content .gpe-publication-caption * {
    color: var(--gpe-publication-caption-color) !important;
    font-family: var(--gpe-publication-caption-font-family) !important;
    font-size: var(--gpe-publication-caption-font-size) !important;
    font-style: normal !important;
    font-weight: var(--gpe-publication-caption-font-weight) !important;
    letter-spacing: normal !important;
    line-height: var(--gpe-publication-caption-line-height) !important;
    text-align: left !important;
    text-transform: none !important;
  }

  .gpe-publication-section :is(.pp-photo-caption, .fl-photo-caption) {
    margin: 0 !important;
    padding: 0.035in 0 0 !important;
  }

  /* Comparison tables span the page and stay together whenever they fit.
     break-inside is a soft fragmentation preference: an over-page table may
     still split between rows, with its header repeated by the rule below. */
  body:has(.gpe-publication-hero) #fl-main-content .fl-row.gpe-publication-table-row {
    margin: 0 !important;
    break-inside: avoid-page !important;
    page-break-inside: avoid !important;
  }

  /* Page starts are an explicit editorial option, separate from being a
     table. Add this class in Builder only when composition calls for one. */
  body:has(.gpe-publication-hero) #fl-main-content .fl-row.gpe-publication-table-row.gpe-publication-page-start {
    break-before: page !important;
    page-break-before: always !important;
  }

  .gpe-publication-table-wrap {
    overflow: visible !important;
  }

  .gpe-publication-table-wrap table {
    width: 100% !important;
    border: 0.75pt solid #59625b !important;
    border-collapse: collapse !important;
    table-layout: fixed !important;
    font-family: "Liberation Sans", "Nimbus Sans", Arial, Helvetica, sans-serif !important;
    font-size: 9pt !important;
    line-height: 1.2 !important;
  }

  .gpe-publication-table-wrap th,
  .gpe-publication-table-wrap td {
    border: 0.45pt solid #737a74 !important;
    padding: 0.055in 0.06in !important;
    color: #202124 !important;
    text-align: left !important;
    vertical-align: top !important;
    overflow-wrap: break-word !important;
    break-inside: avoid !important;
  }

  .gpe-publication-table-wrap thead th {
    background: #eef1e9 !important;
    color: #26372b !important;
    font-weight: 700 !important;
    text-align: center !important;
  }

  .gpe-publication-table-wrap tbody th {
    width: 22% !important;
    background: #f7f6f2 !important;
    color: #26372b !important;
    font-weight: 700 !important;
  }

  .gpe-publication-table-wrap :is(th, td):nth-child(2) {
    width: 32% !important;
  }

  .gpe-publication-table-wrap :is(th, td):nth-child(3) {
    width: 46% !important;
  }

  .gpe-publication-table-wrap thead {
    display: table-header-group !important;
  }

  .gpe-publication-table-wrap tr {
    break-inside: avoid !important;
    page-break-inside: avoid !important;
  }

  body:has(.gpe-publication-hero) table caption,
  .gpe-publication-figure-label {
    caption-side: bottom !important;
    padding: 0.055in 0 0 !important;
  }

  /* The closing panorama is full width, then references resume the
     publication-wide columns beneath it. Its page position is controlled by
     a movable gpe-publication-page-break Separator in Builder. */
  body:has(.gpe-publication-hero) #fl-main-content .fl-builder-content > .fl-row.gpe-publication-figure-row {
    margin: 0 0 0.12in !important;
    /* Reserve the reference position while leaving enough room for the
       editable footer clearance on this seven-page publication family. */
    padding: 0 0 calc(3.37in - 12px) !important;
    break-inside: avoid-page !important;
    page-break-inside: avoid !important;
  }

  .gpe-publication-figure-row figure.gpe-publication-figure,
  .gpe-publication-figure-row :is(.pp-photo-container, .pp-photo, .pp-photo-content, .pp-photo-content-inner) {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
  }

  .gpe-publication-figure-row .pp-photo img {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    max-height: none !important;
    object-fit: contain !important;
  }

  .gpe-publication-figure-row figure.gpe-publication-figure figcaption {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
  }

  .gpe-publication-reference-list {
    margin: 0 0 0.07in !important;
    padding: 0 !important;
    list-style: none !important;
  }

  .gpe-publication-reference-list li {
    break-inside: avoid-column !important;
    margin: 0 0 0.035in !important;
    padding-left: 0.1in !important;
    text-indent: -0.1in;
  }

  .gpe-publication-reference-list a,
  .gpe-publication-reference-list a:visited {
    color: #174f7a !important;
    text-decoration: underline !important;
  }

  body:has(.gpe-publication-hero) #fl-main-content .fl-row.gpe-publication-print-info-row {
    break-inside: avoid-page !important;
    page-break-inside: avoid !important;
  }

  .gpe-publication-info-bar {
    margin: 0 !important;
    padding: 0.055in !important;
    /* The logo red against white is 4.78:1 (WCAG AA for normal text). */
    background: var(--gpe-publication-brand-red) !important;
    color: #fff !important;
    font-family: "Liberation Sans", "Nimbus Sans", Arial, Helvetica, sans-serif !important;
    font-size: 8.25pt !important;
    line-height: 1.2 !important;
    text-align: center !important;
  }

  .gpe-publication-info-bar a,
  .gpe-publication-info-bar a:visited {
    color: #fff !important;
    font-weight: 700 !important;
    text-decoration: underline !important;
  }

  body:has(.gpe-publication-hero) a[href]::after {
    content: none !important;
  }

  .gpe-publication-section a:not(.gpe-publication-reference-list a),
  .gpe-publication-hero a {
    color: inherit !important;
    text-decoration: none !important;
  }

  /* The generic publication-copy and link rules above are intentionally
     broad. Reassert the callout palette after them so authored paragraph
     and link wrappers cannot turn the text dark against the orange bar. */
  body:has(.gpe-publication-hero) .gpe-publication-info-bar,
  body:has(.gpe-publication-hero) .gpe-publication-info-bar * {
    color: #fff !important;
  }

  body:has(.gpe-publication-hero) .gpe-publication-info-bar :is(a, a:visited) {
    text-decoration: underline !important;
  }

  .gpe-publication-section {
    background: transparent !important;
    border: 0 !important;
    font-family: "Liberation Serif", "Nimbus Roman", "Times New Roman", serif !important;
  }
}
</style><style id="gpfse-publication-screen-styles" data-no-optimize="1">/*
 * Browser-only publication layout.
 *
 * This file is omitted entirely from signed PDF requests. Gotenberg can use
 * screen media while composing a PDF, so @media alone is not an isolation
 * boundary for rules that change Beaver Builder geometry.
 */

@media screen {
  body.gpe-publication-web-view:has(.gpe-publication-hero) #fl-main-content .fl-builder-content[data-post-id] {
    --gpe-publication-screen-inline-space: clamp(1rem, 3vw, 2rem);
    --gpe-publication-screen-section-space: clamp(1.5rem, 2.5vw, 2rem);
    --gpe-publication-screen-module-space: 1rem;
  }

  body.gpe-publication-web-view:has(.gpe-publication-hero) #fl-main-content .gpe-publication-hero {
    background: transparent;
  }

  /* Beaver Builder places vertical space on both row wrappers and modules.
   * Collapse those layers, then apply one reusable publication rhythm. The
   * same inline gutter aligns every hero, heading, paragraph, image, caption,
   * and table without page-specific pixel pushing. */
  body.gpe-publication-web-view:has(.gpe-publication-hero) #fl-main-content .fl-builder-content[data-post-id]
      > :is(.fl-row.gpe-publication-hero, .fl-row.gpe-publication-section):not(.gpe-publication-print-info-row)
      > .fl-row-content-wrap {
    padding-top: 0 !important;
    padding-right: var(--gpe-publication-screen-inline-space) !important;
    padding-bottom: 0 !important;
    padding-left: var(--gpe-publication-screen-inline-space) !important;
  }

  body.gpe-publication-web-view:has(.gpe-publication-hero) #fl-main-content .fl-builder-content[data-post-id]
      > .fl-row:not(.gpe-publication-print-info-row)
      + .fl-row:not(.gpe-publication-print-info-row)
      > .fl-row-content-wrap {
    padding-top: var(--gpe-publication-screen-section-space) !important;
  }

  body.gpe-publication-web-view:has(.gpe-publication-hero) #fl-main-content .fl-builder-content[data-post-id]
      :is(.gpe-publication-hero, .gpe-publication-section):not(.gpe-publication-print-info-row)
      :is(.fl-module-content, .fl-module:not(:has(> .fl-module-content))) {
    margin-top: 0 !important;
    margin-right: 0 !important;
    margin-bottom: 0 !important;
    margin-left: 0 !important;
  }

  body.gpe-publication-web-view:has(.gpe-publication-hero) #fl-main-content .fl-builder-content[data-post-id]
      .gpe-publication-section:not(.gpe-publication-print-info-row)
      .fl-module + .fl-module {
    margin-top: var(--gpe-publication-screen-module-space);
  }

  body.gpe-publication-web-view:has(.gpe-publication-hero) #fl-main-content .fl-builder-content[data-post-id]
      .gpe-publication-hero .gpe-publication-byline {
    margin-top: var(--gpe-publication-screen-module-space);
  }

  body.gpe-publication-web-view:has(.gpe-publication-hero) #fl-main-content .gpe-publication-section
      figure.gpe-publication-figure {
    margin-bottom: 0;
  }

  body.gpe-publication-web-view:has(.gpe-publication-hero) #fl-main-content
      :is(.gpe-publication-photo .pp-photo-caption,
          .gpe-publication-photo .fl-photo-caption-below,
          .gpe-publication-section figure.gpe-publication-figure figcaption) {
    padding: 0.5rem 0 0 !important;
    background: transparent !important;
  }

  /* The module's node label also reads “PDF Page Break” in Builder. This
   * canvas marker makes the otherwise print-only control easy to spot and
   * drag without leaking a divider or extra space onto the web page. */
  :is(html, body).fl-builder-edit .gpe-publication-page-break::before {
    content: "PDF page break";
    display: block;
    box-sizing: border-box;
    width: 100%;
    padding: 0.45rem 0.75rem;
    border: 1px dashed var(--gpe-publication-brand-orange);
    background: #fff7f1;
    color: #7a321b;
    font: 600 13px/1.25 Arial, Helvetica, sans-serif;
    text-align: center;
  }

  :is(html, body).fl-builder-edit .gpe-publication-page-break .fl-separator {
    display: none;
  }
}
